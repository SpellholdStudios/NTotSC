//AR9PBA.baf
@0 = ~Sur le chemin du retour, vous avez remarqué une petite île et, malgré de nombreuses difficultés, vous avez réussi à débarquer en vue de vous ravitailler pour la suite du voyage. L'île semble être habitée.~

//ntcutres.baf
@10 = ~Vous avez pris un repos bien mérité.~

//SHIP.baf; SHIP1.baf
@30 = ~Vous devez vous procurer les cartes marines si vous souhaitez retourner sur le continent en toute sécurité.~


/* nouveauté pour la v2.0 */

//ar30pb.baf
@40 = ~Défendre la Citadelle !~

//nttr51pb.baf (déclencheur avant l'ouverture du donjon du Pont de Flammevin par le parchemin de Charleston Nib
@50 = ~Le parchemin vous protège de la magie qui scellait l'entrée. Vous pouvez maintenant entrer.~
@51 = ~Vous jetez un rapide coup d'œil à l'entrée. Dans la pénombre, vous voyez suffisamment de mouvement pour savoir qu'il s'agit d'un donjon où vous ne devez pas vous aventurer sans préparation, et de préférence avec un prêtre aguerri.~
@52 = ~Le passage est bloqué par des protections puissantes et étranges. Vous devez trouver un moyen de les désactiver si vous souhaitez entrer.~
@53 = ~Pour examiner cette entrée, approchez-vous.~

/* ar4500.baf */
@54 = ~L'entrée du donjon~

//indo52pb.baf (déclenche l'entrée vers ar53pb.are)
@60 = ~Le feu de l'huile produit une lumière vacillante mais agréable. Vous pouvez maintenant descendre les escaliers.~
@61 = ~L'escalier mène dans l'obscurité totale. Vous devrez trouver une source de lumière pour entrer.~
@62 = ~La lumière de la gemme est vive et constante. Vous pouvez maintenant descendre les escaliers.~
@63 = ~La lumière de la bougie est faible et vacillante, mais vous pouvez maintenant descendre les escaliers.~
